.PHONY: help

help:
	@echo "CredPivot Make 目标（能力拆分在 make/*.mk）"
	@echo ""
	@echo "Rust:"
	@echo "  make rust-build          编译 workspace（release）"
	@echo "  make rust-dev            编译 workspace（debug）"
	@echo "  make rust-agent          仅 credpivot-agent"
	@echo "  make rust-host           仅 credpivot-native-host"
	@echo "  make rust-ffi            仅 credpivot-ffi（macOS Flutter 链接）"
	@echo "  make rust-cli            独立恢复工具（默认 release）"
	@echo "  make rust-check          cargo check --workspace"
	@echo "  make rust-test           Agent 锁定策略等单元测试"
	@echo ""
	@echo "macOS App:"
	@echo "  make macos-bootstrap     首次完整引导（flutter create + 构建）"
	@echo "  make macos-pub-get       flutter pub get"
	@echo "  make macos-sync-artifacts 复制 Rust 产物到 Runner"
	@echo "  make macos-build         debug 构建（默认）"
	@echo "  make macos-build-debug   同 macos-build"
	@echo "  make macos-build-release release 构建"
	@echo "  make macos-install       release 构建并安装到 /Applications/CredPivot.app（需先退出旧 App）"
	@echo ""
	@echo "Chrome:"
	@echo "  make chrome-info         扩展路径与加载说明"
	@echo "  make chrome-host-manifest 写入 Native Messaging Host 清单"
	@echo ""
	@echo "清理:"
	@echo "  make clean-rust / clean-flutter / clean"
	@echo ""
	@echo "发布（生成到 dist/，不上传）:"
	@echo "  make release             App、独立 CLI、Chrome 扩展及各自 SHA-256"
	@echo "  make release-app / release-cli / release-extension"
	@echo "  release-app 生成 DMG，打开后将 CredPivot 拖入应用程序"
	@echo ""
	@echo "变量: CARGO_PROFILE=debug|release  FLUTTER=...  CARGO=..."
	@echo '  MACOS_INSTALL_DIR="$$HOME/Applications" 可改为仅当前用户安装'
