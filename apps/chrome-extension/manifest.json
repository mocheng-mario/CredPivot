{
  "manifest_version": 3,
  "name": "CredPivot",
  "version": "0.3.1",
  "description": "Requires CredPivot Mac App, native host manifest, and unlocked vault (master password).",
  "permissions": ["nativeMessaging", "storage", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CredPivot"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
