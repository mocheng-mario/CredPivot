{
  "manifest_version": 3,
  "name": "CredPivot",
  "version": "0.8.0",
  "minimum_chrome_version": "111",
  "description": "Connects to CredPivot Mac App with fingerprint or in-app master password verification.",
  "permissions": ["nativeMessaging", "storage", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CredPivot"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["passkey_bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
