#!/usr/bin/expect -f
# CredPivot SSH 自动认证（PTY + Agent 会话取密，不落盘明文密码）

set username ""
set hostname ""
set port ""
set session_id ""
set askpass_bin ""

proc usage {} {
    global argv0
    puts "Usage:"
    puts "  $argv0 --user USER --host HOST --session-id ID --askpass PATH [--port PORT]"
}

for {set i 0} {$i < [llength $argv]} {incr i} {
    set key [lindex $argv $i]
    switch -- $key {
        "--user" { incr i; set username [lindex $argv $i] }
        "--host" { incr i; set hostname [lindex $argv $i] }
        "--port" { incr i; set port [lindex $argv $i] }
        "--session-id" { incr i; set session_id [lindex $argv $i] }
        "--askpass" { incr i; set askpass_bin [lindex $argv $i] }
        default {
            puts "Unknown argument: $key"
            usage
            exit 1
        }
    }
}

if {$username eq "" || $hostname eq "" || $session_id eq "" || $askpass_bin eq ""} {
    puts "Missing required argument."
    usage
    exit 1
}

if {$port ne "" && ![string is integer -strict $port]} {
    puts "Invalid port: $port"
    usage
    exit 1
}

proc fetch_secret {kind} {
    global session_id askpass_bin
    set env(CREDPIVOT_SESSION_ID) $session_id
    set env(CREDPIVOT_FORCE_KIND) $kind
    if {[catch {exec $askpass_bin} result]} {
        send_user "\r\nCredPivot: 无法从 Agent 获取 $kind（$result）。\r\n"
        return ""
    }
    return [string trim $result "\t\n\r "]
}

set timeout 45
set password_tries 0
set max_password_tries 4

log_user 1

if {$port eq ""} {
    spawn ssh -tt \
        -o StrictHostKeyChecking=accept-new \
        -o UserKnownHostsFile=$env(HOME)/.ssh/known_hosts \
        -o PubkeyAuthentication=no \
        -o PasswordAuthentication=yes \
        -o KbdInteractiveAuthentication=yes \
        -o PreferredAuthentications=keyboard-interactive,password \
        -o NumberOfPasswordPrompts=$max_password_tries \
        "$username@$hostname"
} else {
    spawn ssh -tt \
        -o StrictHostKeyChecking=accept-new \
        -o UserKnownHostsFile=$env(HOME)/.ssh/known_hosts \
        -o PubkeyAuthentication=no \
        -o PasswordAuthentication=yes \
        -o KbdInteractiveAuthentication=yes \
        -o PreferredAuthentications=keyboard-interactive,password \
        -o NumberOfPasswordPrompts=$max_password_tries \
        -p "$port" \
        "$username@$hostname"
}

proc send_password {} {
    global password_tries max_password_tries
    if {$password_tries >= $max_password_tries} {
        send_user "\r\nCredPivot: 密码尝试次数已达上限，请手动输入。\r\n"
        interact
        exit 1
    }
    incr password_tries
    set pw [fetch_secret "password"]
    if {$pw eq ""} {
        send_user "\r\nCredPivot: 密码为空，请手动输入。\r\n"
        interact
        return
    }
    send -- "$pw\r"
}

proc send_otp {} {
    set code [fetch_secret "otp"]
    if {$code eq ""} {
        send_user "\r\nCredPivot: MFA 验证码获取失败，请手动输入。\r\n"
        interact
        return
    }
    send -- "$code\r"
}

while {1} {
    expect {
        -nocase -re {are you sure you want to continue connecting} {
            send "yes\r"
        }
        -nocase "yes/no" {
            send "yes\r"
        }
        -nocase -re {password:\s*$} {
            send_password
        }
        -nocase -re {passphrase:\s*$} {
            send_password
        }
        -nocase -re {verification code|one-time code|otp code|mfa code} {
            send_otp
        }
        -re {请输入 MFA 验证码} {
            send_otp
        }
        -re {请输入验证码} {
            send_otp
        }
        -re {Permission denied \(publickey,password\)} {
            send_user "\r\nCredPivot: 认证失败（公钥与密码均被拒绝）。\r\n"
            interact
            exit 1
        }
        -re {[@%$#>]\s*$} {
            break
        }
        timeout {
            send_user "\r\nCredPivot: 等待提示超时，进入手动交互。\r\n"
            interact
            exit 0
        }
        eof {
            exit 0
        }
    }
}

interact
