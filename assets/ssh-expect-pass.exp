#!/usr/bin/expect -f
# credpivot-expect-version: 3
# CredPivot SSH 自动认证（PTY + Agent 会话取密，不落盘明文密码）

set username ""
set hostname ""
set port ""
set session_id ""
set askpass_bin ""
set identity_file ""
set identity_agent ""

# Expect 默认会把 SIGINT/SIGTERM 当作成功退出；终端取消应返回对应的失败状态。
trap {exit [expr {128 + [trap -number]}]} {SIGINT SIGTERM SIGHUP}

proc finish_ssh {} {
    global spawn_id
    catch {close -i $spawn_id}
    if {[catch {wait -i $spawn_id} result] || [llength $result] < 4 || [lindex $result 2] != 0} {
        exit 255
    }
    if {[lindex $result 4] eq "CHILDKILLED"} {
        # 重发子进程的终止信号，让 shell 得到原来的信号退出状态。
        set signal [lindex $result 5]
        catch {trap SIG_DFL $signal}
        catch {exec /bin/kill -s [string range $signal 3 end] [pid]}
        exit 255
    }
    exit [lindex $result 3]
}

proc manual_interaction {} {
    global spawn_id
    catch {interact}
    finish_ssh
}

proc usage {} {
    global argv0
    puts "Usage:"
    puts "  $argv0 --user USER --host HOST --session-id ID --askpass PATH \[--port PORT\] \[--identity-file PATH --identity-agent PATH\]"
}

for {set i 0} {$i < [llength $argv]} {incr i} {
    set key [lindex $argv $i]
    switch -- $key {
        "--user" { incr i; set username [lindex $argv $i] }
        "--host" { incr i; set hostname [lindex $argv $i] }
        "--port" { incr i; set port [lindex $argv $i] }
        "--session-id" { incr i; set session_id [lindex $argv $i] }
        "--askpass" { incr i; set askpass_bin [lindex $argv $i] }
        "--identity-file" { incr i; set identity_file [lindex $argv $i] }
        "--identity-agent" { incr i; set identity_agent [lindex $argv $i] }
        default {
            puts "Unknown argument: $key"
            usage
            exit 1
        }
    }
}

if {$username eq "" || $hostname eq "" || $session_id eq "" || $askpass_bin eq ""} {
    puts "Missing required argument."
    usage
    exit 1
}

if {$port ne "" && ![string is integer -strict $port]} {
    puts "Invalid port: $port"
    usage
    exit 1
}

if {($identity_file eq "") != ($identity_agent eq "")} {
    puts "Missing SSH identity file or agent."
    exit 1
}

proc fetch_secret {kind} {
    global session_id askpass_bin
    if {$session_id eq "" || $askpass_bin eq ""} {
        send_user "\r\nCredPivot: 内部错误：缺少 session_id 或 askpass 路径。\r\n"
        return ""
    }
    # expect 下 `set env(...)` 对 `exec` 子进程不一定生效，用 env 显式传入。
    if {[catch {
        exec -keepnewline /usr/bin/env CREDPIVOT_SESSION_ID=$session_id CREDPIVOT_FORCE_KIND=$kind $askpass_bin
    } result]} {
        send_user "\r\nCredPivot: 无法从 Agent 获取 $kind（$result）。\r\n"
        return ""
    }
    # askpass 不追加换行；密码的首尾空白也是密码的一部分，exec 也不得去掉尾部换行。
    return $result
}

set timeout 45
set password_tries 0
set max_password_tries 4

log_user 1

set ssh_args [list -tt \
    -o StrictHostKeyChecking=accept-new \
    -o UserKnownHostsFile=$env(HOME)/.ssh/known_hosts \
    -o PasswordAuthentication=yes \
    -o KbdInteractiveAuthentication=yes \
    -o NumberOfPasswordPrompts=$max_password_tries]
if {$identity_file ne ""} {
    lappend ssh_args -o PubkeyAuthentication=yes \
        -o PreferredAuthentications=publickey,keyboard-interactive,password \
        -o IdentityAgent=$identity_agent -o IdentitiesOnly=yes \
        -o ControlPath=none -o ControlMaster=no -i $identity_file
} else {
    lappend ssh_args -o PubkeyAuthentication=no -o PreferredAuthentications=keyboard-interactive,password
}
if {$port ne ""} { lappend ssh_args -p $port }
lappend ssh_args "$username@$hostname"
if {$identity_file ne ""} {
    if {[catch {exec /usr/bin/ssh -G {*}$ssh_args 2>/dev/null} config]} {
        send_user "CredPivot: 无法检查 SSH 身份配置。\r\n"
        exit 1
    }
    # IdentityFile 会累加，不能把目标配置里的其他身份一起用于此连接。
    foreach line [split $config "\n"] {
        if {[regexp {^identityfile (.*)$} $line _ path] && $path ne "none" && $path ne $identity_file} {
            send_user "CredPivot: SSH 配置叠加了其他 IdentityFile，请移除该目标的重复身份配置后重试。\r\n"
            exit 1
        }
    }
}
spawn /usr/bin/ssh {*}$ssh_args

proc send_password {} {
    global password_tries max_password_tries
    if {$password_tries >= $max_password_tries} {
        send_user "\r\nCredPivot: 密码尝试次数已达上限，请手动输入。\r\n"
        manual_interaction
    }
    incr password_tries
    set pw [fetch_secret "password"]
    if {$pw eq ""} {
        send_user "\r\nCredPivot: 密码为空，请手动输入。\r\n"
        manual_interaction
    }
    send -- "$pw\r"
}

set otp_tries 0
set max_otp_tries 6

proc send_otp {} {
    global otp_tries max_otp_tries
    if {$otp_tries >= $max_otp_tries} {
        send_user "\r\nCredPivot: MFA 尝试次数已达上限，请手动输入。\r\n"
        manual_interaction
    }
    incr otp_tries
    set code [fetch_secret "otp"]
    if {$code eq ""} {
        send_user "\r\nCredPivot: MFA 验证码获取失败，请手动输入。\r\n"
        manual_interaction
    }
    send -- "$code\r"
}

while {1} {
    expect {
        -nocase -re {are you sure you want to continue connecting} {
            send "yes\r"
        }
        -nocase "yes/no" {
            send "yes\r"
        }
        -nocase -re {password:\s*$} {
            send_password
        }
        -nocase -re {passphrase:\s*$} {
            send_password
        }
        # glob：须同时含「请输入」与 MFA 关键词，避免 banner 里单独的 mfa/2fa 误触发
        -gl "*请输入*验证码*" {
            send_otp
        }
        -gl "*请输入*MFA*" {
            send_otp
        }
        -gl "*请输入*mfa*" {
            send_otp
        }
        -gl "*请输入*otp*" {
            send_otp
        }
        -gl "*请输入*2fa*" {
            send_otp
        }
        -re -nocase {please enter.*(mfa|otp|2fa|verification code)} {
            send_otp
        }
        -re {Permission denied \(publickey,password\)} {
            send_user "\r\nCredPivot: 认证失败（公钥与密码均被拒绝）。\r\n"
            manual_interaction
        }
        -re {[@%$#>]\s*$} {
            break
        }
        timeout {
            send_user "\r\nCredPivot: 等待提示超时，进入手动交互。\r\n"
            manual_interaction
        }
        eof {
            finish_ssh
        }
    }
}

manual_interaction
